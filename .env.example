DB_NAME=global_exchange
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# Correo (Mailtrap)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Global Exchange <no-responder@globalexchange.com.py>
# Segundos entre correos; el sandbox gratuito de Mailtrap admite 1 correo cada 10 segundos
NOTIFICACIONES_PAUSA_ENVIO=11

# Pagos (Stripe, solo modo test). Obtener una clave sk_test_... del sandbox de Stripe.
# El flujo actual usa tokens pm_card_* y no requiere clave publica pk_test_.
STRIPE_SECRET_KEY=
# Configurar automaticamente con: python manage.py configurar_stripe
# Escuchar eventos locales con: python manage.py configurar_stripe --escuchar
# Endpoint: http://127.0.0.1:8000/transacciones/webhooks/stripe/
# Eventos: payment_intent.succeeded,payment_intent.payment_failed
# Usar el secreto del CLI para pruebas locales; el del Dashboard es diferente.
STRIPE_WEBHOOK_SECRET=
